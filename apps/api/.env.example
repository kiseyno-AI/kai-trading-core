# Non-secret runtime defaults now live in app/core/settings.py.
# Copy .env.secrets.example to .env and fill only the required secrets.
# Optional non-secret KIS realtime notice controls can also be set in .env:
# KIS_REALTIME_ORDER_NOTICE_ENABLED=true
# KIS_REALTIME_WS_URL=ws://ops.koreainvestment.com:21000
# KIS_REALTIME_MOCK_WS_URL=ws://ops.koreainvestment.com:31000
# MARKET_SNAPSHOT_KIS_USE_REAL=true
# MARKET_SNAPSHOT_REFRESH_INTERVAL_SECONDS=3600
# KIS_REALTIME_RECONNECT_BASE_DELAY_SECONDS=3
# KIS_REALTIME_RECONNECT_MAX_DELAY_SECONDS=30
# KIS_ORDER_RECONCILE_ENABLED=true
# KIS_ORDER_RECONCILE_STARTUP_ENABLED=true
# KIS_ORDER_RECONCILE_ON_RECONNECT_ENABLED=true
# KIS_ORDER_RECONCILE_INTERVAL_SECONDS=300
# KIS_ORDER_RECONCILE_STALE_AFTER_MINUTES=15
# KIS_ORDER_RECONCILE_RECENT_DAYS=3
# KIS_ORDER_RECONCILE_BATCH_LIMIT=100
# SIGNAL_DECIDER_NEXT_OPEN_ENABLED=false
# SIGNAL_DECIDER_NEXT_OPEN_DRY_RUN=true
# SIGNAL_DECIDER_NEXT_OPEN_ACCOUNT_TARGETS=Main=KIS:12345678-01@1500000,ISA=KIS:87654321-22@750000
# SIGNAL_DECIDER_NEXT_OPEN_MIN_CONFIDENCE_SCORE_10=6.0
# SIGNAL_DECIDER_NEXT_OPEN_MIN_EXPECTED_RETURN_PCT=0.0
# SIGNAL_DECIDER_NEXT_OPEN_REQUIRE_ACTIVE_POLICY=true
# SIGNAL_DECIDER_NEXT_OPEN_BLOCK_ON_DATA_WARNINGS=true
# SIGNAL_DECIDER_NEXT_OPEN_BLOCK_ON_SPECIALIST_DISAGREEMENT=true
# SIGNAL_DECIDER_NEXT_OPEN_REQUIRE_TARGET_AND_STOP=true
# SIGNAL_DECIDER_EXEC_INTEGRATION_MODE=disabled
# SIGNAL_DECIDER_EXEC_BASE_URL=http://127.0.0.1:8010
# SIGNAL_DECIDER_EXEC_BEARER_TOKEN=
# SIGNAL_DECIDER_EXEC_DISPATCH_SOURCE=kai-trading-core
# SIGNAL_DECIDER_EXEC_RUNTIME_MODE=mock
# SIGNAL_DECIDER_EXEC_REQUEST_TIMEOUT_SECONDS=10
# SIGNAL_DECIDER_INTRADAY_AUTO_SELL_ENABLED=false
# SIGNAL_DECIDER_INTRADAY_AUTO_SELL_DRY_RUN=true
# SIGNAL_DECIDER_INTRADAY_AUTO_SELL_COOLDOWN_SECONDS=120
# APP_ENV=production
# KIS_USE_MOCK=false
# PORTFOLIO_ACCOUNT_REFERENCES=Main=KIS:12345678-01,ISA=KIS:87654321-22
# PORTFOLIO_SUMMARY_CACHE_TTL_SECONDS=60
# EOD_PYKRX_ENRICHMENT_PAUSE_SECONDS=0.05
# EOD_PYKRX_ENRICHMENT_RETRY_COUNT=2
# EOD_PYKRX_ENRICHMENT_RETRY_BACKOFF_SECONDS=0.5
# Production portfolio summary also requires KIS_APP_KEY and KIS_APP_SECRET in .env.secrets.example.
# OPENCLAW_STATE_DIR=~/.openclaw

# See: apps/api/app/core/settings.py
# Secret template: apps/api/.env.secrets.example
