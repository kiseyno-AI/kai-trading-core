APP_NAME=kai-trading-core-api
APP_ENV=development
APP_DEBUG=true
UPSTREAM_BEARER_TOKEN=
API_REQUEST_LOGGING_ENABLED=true
UPSTREAM_HTTP_LOGGING_ENABLED=true
API_LOG_DIRECTORY=var/log
API_REQUEST_LOG_FILE_NAME=api-requests.log
UPSTREAM_HTTP_LOG_FILE_NAME=upstream-http.log
API_LOG_ROTATION_MAX_BYTES=20971520
API_LOG_ROTATION_BACKUP_COUNT=10

DB_AUTO_UPGRADE=true
DATABASE_URL=postgresql://kai_trading_app:kai_trading_dev@localhost:5432/kai_trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kai_trading
POSTGRES_USER=kai_trading_app
POSTGRES_PASSWORD=kai_trading_dev

KIS_APP_KEY=replace_me
KIS_APP_SECRET=replace_me
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_MOCK_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_USE_MOCK=false
KIS_TOKEN_REFRESH_MARGIN_SECONDS=300
BOK_ECOS_API_KEY=replace_me
BOK_ECOS_BASE_URL=https://ecos.bok.or.kr/api
KOREAEXIM_API_KEY=replace_me
KOREAEXIM_BASE_URL=https://oapi.koreaexim.go.kr/site/program/financial/exchangeJSON
KOREAEXIM_FALLBACK_DAYS=2
DART_API_KEY=replace_me
DART_BASE_URL=https://opendart.fss.or.kr/api
DART_CORP_CODE_CACHE_TTL_SECONDS=86400
DART_SYNC_RECENT_DAYS=7
DART_SYNC_PAGE_COUNT=100

EOD_AUTO_PYKRX_ENABLED=true
EOD_AUTO_PYKRX_POLL_SECONDS=60
EOD_AUTO_PYKRX_AFTER_CLOSE_MINUTES=10
EOD_AUTO_PYKRX_MARKETS=KOSPI,KOSDAQ,KONEX
EOD_AUTO_PYKRX_REFRESH_UNIVERSE=true
EOD_AUTO_PYKRX_STALE_RUN_MINUTES=30
EOD_PYKRX_REQUEST_TIMEOUT_SECONDS=20
