# Non-secret runtime defaults now live in app/core/settings.py.
# Copy .env.secrets.example to .env and fill only the required secrets.
# Optional non-secret KIS realtime notice controls can also be set in .env:
# KIS_REALTIME_ORDER_NOTICE_ENABLED=true
# KIS_REALTIME_PRICE_ENABLED=true
# KIS_REALTIME_PRICE_TR_ID=H0STCNT0
# KIS_REALTIME_PRICE_MAX_SUBSCRIPTIONS=40
# KIS_REALTIME_PRICE_SUBSCRIPTION_REFRESH_SECONDS=30
# KIS_REALTIME_PRICE_IDLE_POLL_SECONDS=5
# KIS_REALTIME_PRICE_STALE_AFTER_SECONDS=30
# KIS_REALTIME_PRICE_SUBSCRIBE_PAUSE_SECONDS=0.05
# KIS_REALTIME_PRICE_UNSUBSCRIBE_TR_TYPE=2
# KIS_REALTIME_PRICE_SSE_INTERVAL_SECONDS=1
# KIS_REALTIME_WS_URL=ws://ops.koreainvestment.com:21000
# KIS_REALTIME_MOCK_WS_URL=ws://ops.koreainvestment.com:31000
# Shared with kai-trading-exec; resolves to an absolute, private 0700 directory.
# KIS_TOKEN_CACHE_DIRECTORY=~/.cache/kai-trading/kis-oauth-tokens
# KIS_TOKEN_REFRESH_MARGIN_SECONDS=300
# KIS_TOKEN_FAILURE_COOLDOWN_SECONDS=60
# KIS_TOKEN_REQUEST_TIMEOUT_SECONDS=15
# KIS_TOKEN_ISSUANCE_LEASE_SECONDS=90
# KIS_TOKEN_MIN_ISSUE_INTERVAL_SECONDS=60
# MARKET_SNAPSHOT_KIS_USE_REAL=true
# MARKET_SNAPSHOT_REFRESH_INTERVAL_SECONDS=3600
# During the KRX 09:00-14:30 opening/trend evidence window, refresh only the
# KIS index leg every five minutes; flow/FX keep their normal hourly cadence.
# The interval must not exceed the evidence max age.
# MARKET_SNAPSHOT_OPEN_DRIVE_REFRESH_INTERVAL_SECONDS=300
# MARKET_SNAPSHOT_OPEN_DRIVE_MAX_AGE_SECONDS=360
# UPBIT_BASE_URL=https://api.upbit.com
# UPBIT_REQUEST_TIMEOUT_SECONDS=10
# UPBIT_MARKET_WHITELIST=KRW-BTC,KRW-ETH
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=5
# DB_POOL_RECYCLE_SECONDS=900
# DB_POOL_USE_LIFO=true
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_HEALTHCHECK_TIMEOUT_SECONDS=2
# Agent-feedback rows contain large JSON payloads and maintain several indexes.
# Keep these writes bounded without applying the API's short read timeout to them.
# AGENT_FEEDBACK_DB_STATEMENT_TIMEOUT_MS=30000
# AGENT_FEEDBACK_DB_LOCK_TIMEOUT_MS=15000
# Signal-decider evaluation/review rows contain large JSON payloads. These
# operations use a dedicated timeout instead of the API's short read timeout.
# SIGNAL_DECIDER_DB_STATEMENT_TIMEOUT_MS=300000
# SIGNAL_DECIDER_DB_LOCK_TIMEOUT_MS=30000
# DB_LONG_CHECKOUT_WARNING_SECONDS=10
# DB_POOL_WATCHDOG_ENABLED=false
# DB_POOL_WATCHDOG_CANCEL_ENABLED=false
# KIS_INTRADAY_SNAPSHOT_ENABLED=true
# KIS_INTRADAY_SNAPSHOT_MARKET_CODE=J
# KIS_INTRADAY_SNAPSHOT_MAX_RANKING_PAGES=2
# KIS_INTRADAY_SNAPSHOT_NEWS_PAGES=2
# KIS_INTRADAY_SNAPSHOT_NEWS_LIMIT=5
# EXTERNAL_NEWS_DEFAULT_DISPLAY=10
# EXTERNAL_NEWS_CONTEXT_LIMIT=3
# EXTERNAL_NEWS_CONTEXT_LOOKBACK_DAYS=14
# EXTERNAL_NEWS_REQUEST_TIMEOUT_SECONDS=10
# EXTERNAL_NEWS_COLLECT_THROTTLE_SECONDS=0.15
# MACRO_CONTEXT_ENABLED=true
# MACRO_CONTEXT_REFRESH_MIN_INTERVAL_HOURS=24
# MACRO_CONTEXT_STALE_AFTER_HOURS=72
# MACRO_CONTEXT_WORLD_BANK_ENABLED=true
# MACRO_CONTEXT_WORLD_BANK_COUNTRY=KOR
# MACRO_CONTEXT_WORLD_BANK_SERIES=NY.GDP.MKTP.KD.ZG,FP.CPI.TOTL.ZG,SL.UEM.TOTL.ZS
# MACRO_CONTEXT_FRED_ENABLED=true
# MACRO_CONTEXT_FRED_SERIES=DEXKOUS
# FRED_API_KEY=
# Bound the deterministic rotating daily probe for active symbols with no stored fundamentals.
# Zero disables this probe; it does not enable the separate initial-backfill path.
# DART_FUNDAMENTALS_DAILY_INITIAL_BACKFILL_ENABLED=false
# DART_FUNDAMENTALS_DAILY_MISSING_SYMBOL_PROBE_LIMIT=100
# DART_FUNDAMENTALS_DAILY_INCREMENTAL_LOOKBACK_DAYS=45
# Same-day KRX EOD waits until 20:10 KST: 15:30 close + 280 minutes,
# covering the 20:00 NXT after-market close plus a 10-minute settle buffer.
# Values below 280 are rejected at startup so an old override cannot reopen
# the pre-settlement collection window.
# Older incomplete trading dates are inspected before/during the session but resume
# only after this same 20:10 finality floor on trading days.
# EOD_AUTO_PYKRX_AFTER_CLOSE_MINUTES=280
# KIS_REALTIME_RECONNECT_BASE_DELAY_SECONDS=3
# KIS_REALTIME_RECONNECT_MAX_DELAY_SECONDS=30
# US screening first uses KIS rankings, then downloads adjusted history only for the bounded shortlist.
# US_EQUITY_PRICE_PREFILTER_CAP=600
# US_EQUITY_RANKING_MAX_PAGES=3
# US_EQUITY_HISTORY_MAX_PAGES=4
# US_EQUITY_HISTORY_CONCURRENCY=2
# US_EQUITY_HISTORY_REQUEST_PAUSE_SECONDS=0.12
# US_EQUITY_SEC_CONCURRENCY=8
# Reserved for a future currency-aware Exec capability; current US handoff is preview-only.
# US_EQUITY_EXECUTION_ENABLED=false
# US_EQUITY_EXEC_MAX_CANDIDATES=10
# US_EQUITY_EXEC_PER_SYMBOL_BUDGET_USD=100
# US_EQUITY_EXEC_MIN_CONFIDENCE_SCORE_10=7
# US_EQUITY_EXEC_MIN_REWARD_RISK_RATIO=1.5
# US_EQUITY_EXEC_LIMIT_BUFFER_PCT=0.50
# US_EQUITY_AUTO_PIPELINE_ENABLED=false
# US_EQUITY_AUTO_PIPELINE_LOCAL_TIME=18:00
# US_EQUITY_AUTO_PIPELINE_INTERVAL_SECONDS=60
# US_EQUITY_AUTO_PIPELINE_EXEC_DRY_RUN=true
# US_EQUITY_AUTO_PIPELINE_STALE_AFTER_MINUTES=180
# KIS_ORDER_RECONCILE_ENABLED=true
# KIS_ORDER_RECONCILE_STARTUP_ENABLED=true
# KIS_ORDER_RECONCILE_ON_RECONNECT_ENABLED=true
# KIS_ORDER_RECONCILE_INTERVAL_SECONDS=300
# KIS_ORDER_RECONCILE_STALE_AFTER_MINUTES=15
# KIS_ORDER_RECONCILE_RECENT_DAYS=3
# KIS_ORDER_RECONCILE_BATCH_LIMIT=100
# SIGNAL_DECIDER_NEXT_OPEN_ENABLED=false
# SIGNAL_DECIDER_NEXT_OPEN_DRY_RUN=true
# SIGNAL_DECIDER_NEXT_OPEN_ACCOUNT_TARGETS=Main=KIS:12345678-01@1500000,ISA=KIS:87654321-22@750000
# SIGNAL_DECIDER_NEXT_OPEN_MIN_CONFIDENCE_SCORE_10=6.0
# SIGNAL_DECIDER_NEXT_OPEN_MIN_EXPECTED_RETURN_PCT=0.0
# SIGNAL_DECIDER_NEXT_OPEN_MIN_REWARD_RISK_RATIO=1.30
# Server-owned conservative fees/taxes/non-spread round-trip allowance for Core-local buys.
# This is additive only: it cannot replace execution-time spread evidence. Signal-decider
# next-open direct buys stay blocked until Core has a real execution-time quote recheck.
# Exec dispatch uses Exec's final live full-cost check instead.
# SIGNAL_DECIDER_NEXT_OPEN_NON_SPREAD_ROUND_TRIP_COST_BPS=50.0
# SIGNAL_DECIDER_NEXT_OPEN_REQUIRE_ACTIVE_POLICY=true
# SIGNAL_DECIDER_NEXT_OPEN_BLOCK_ON_DATA_WARNINGS=true
# SIGNAL_DECIDER_NEXT_OPEN_BLOCK_ON_SPECIALIST_DISAGREEMENT=true
# SIGNAL_DECIDER_NEXT_OPEN_REQUIRE_TARGET_AND_STOP=true
# report_only remains the live default; guarded promotion values are hard_block or downsize_probe.
# SIGNAL_DECIDER_WAIT_CONFLICT_GATE_MODE=report_only
# SIGNAL_DECIDER_WAIT_CONFLICT_PROBE_QUANTITY=1
# Observe prior-session WAIT rows from either decision lane when they contain
# coherent trigger geometry. Reassessment v3 requires a supported live evidence
# window, applies a deterministic reward/risk prefilter before provider work,
# and permits only bounded, materially changed same-day generations. It never
# grants direct order authority.
# SIGNAL_DECIDER_WAIT_RECHECK_MONITORING_ENABLED=false
# SIGNAL_DECIDER_WAIT_RECHECK_MAX_SYMBOLS=20
# SIGNAL_DECIDER_WAIT_RECHECK_MAX_EVENTS_PER_CYCLE=3
# SIGNAL_DECIDER_WAIT_RECHECK_MAX_GENERATIONS_PER_DAY=2
# SIGNAL_DECIDER_WAIT_RECHECK_MAX_DAILY_EVENTS=20
# SIGNAL_DECIDER_WAIT_RECHECK_REARM_COOLDOWN_SECONDS=120
# SIGNAL_DECIDER_WAIT_RECHECK_EVIDENCE_WINDOW_SECONDS=30
# SIGNAL_DECIDER_WAIT_RECHECK_EVIDENCE_MAX_SAMPLES=60
# SIGNAL_DECIDER_WAIT_RECHECK_EVIDENCE_MIN_SAMPLES=3
# SIGNAL_DECIDER_WAIT_RECHECK_EVIDENCE_MIN_SPAN_SECONDS=5
# SIGNAL_DECIDER_WAIT_RECHECK_EVIDENCE_MIN_SUPPORT_RATIO=0.8
# SIGNAL_DECIDER_WAIT_RECHECK_MATERIAL_PRICE_MOVE_BPS=25
# SIGNAL_DECIDER_WAIT_RECHECK_MATERIAL_VOLUME_GROWTH_PCT=0.5
# SIGNAL_DECIDER_WAIT_RECHECK_MATERIAL_DEPTH_IMBALANCE_DELTA=0.2
# Provider failures retry only after this cooldown and a wholly new supported
# realtime evidence window; the prior request context is archived durably.
# SIGNAL_DECIDER_WAIT_RECHECK_MAX_ATTEMPTS=2
# SIGNAL_DECIDER_WAIT_RECHECK_RETRY_COOLDOWN_SECONDS=300
# SIGNAL_DECIDER_WAIT_RECHECK_RUNNING_TIMEOUT_SECONDS=600
# SIGNAL_DECIDER_EXEC_INTEGRATION_MODE=disabled
# SIGNAL_DECIDER_EXEC_BASE_URL=http://127.0.0.1:8010
# SIGNAL_DECIDER_EXEC_BEARER_TOKEN=
# SIGNAL_DECIDER_EXEC_DISPATCH_SOURCE=kai-trading-core
# SIGNAL_DECIDER_EXEC_RUNTIME_MODE=mock
# SIGNAL_DECIDER_EXEC_REQUEST_TIMEOUT_SECONDS=10
# SIGNAL_DECIDER_EXEC_DASHBOARD_CACHE_TTL_SECONDS=5
# SIGNAL_DECIDER_EXEC_DASHBOARD_REFRESH_DEBOUNCE_SECONDS=15
# SIGNAL_DECIDER_EXEC_DASHBOARD_REFRESH_TIMEOUT_SECONDS=30
# SIGNAL_DECIDER_INTRADAY_AUTO_SELL_ENABLED=false
# SIGNAL_DECIDER_INTRADAY_AUTO_SELL_DRY_RUN=true
# SIGNAL_DECIDER_INTRADAY_AUTO_SELL_COOLDOWN_SECONDS=120
# APP_ENV=production
# KIS_USE_MOCK=false
# PORTFOLIO_ACCOUNT_REFERENCES=Main=KIS:12345678-01,ISA=KIS:87654321-22
# PORTFOLIO_SUMMARY_CACHE_TTL_SECONDS=60
# EOD_PYKRX_ENRICHMENT_PAUSE_SECONDS=0.05
# EOD_PYKRX_ENRICHMENT_RETRY_COUNT=2
# EOD_PYKRX_ENRICHMENT_RETRY_BACKOFF_SECONDS=0.5
# SEC requires a declared requester name plus an administrative contact email.
# SEC_EDGAR_USER_AGENT=Your Name your-email@example.com
# SEC_EDGAR_REQUESTS_PER_SECOND=8
# SEC_EDGAR_DATA_BASE_URL=https://data.sec.gov
# SEC_EDGAR_WWW_BASE_URL=https://www.sec.gov
# NASDAQ_TRADER_BASE_URL=https://www.nasdaqtrader.com
# US_EQUITY_UNIVERSE_MIN_NASDAQ_ROWS=1000
# US_EQUITY_UNIVERSE_MIN_KIS_ROWS=1000
# US_EQUITY_UNIVERSE_MIN_SEC_ROWS=1000
# US_EQUITY_UNIVERSE_MIN_INTEGRATED_ROWS=100
# KIS_OVERSEAS_MASTER_BASE_URL=https://new.real.download.dws.co.kr
# OPENCLAW_FEEDBACK_BROAD_CANDIDATE_CAP_PERCENTILE=0.10
# OPENCLAW_FEEDBACK_BROAD_CANDIDATE_CAP_MIN_SYMBOLS=150
# OPENCLAW_FEEDBACK_BROAD_CANDIDATE_CAP_MAX_SYMBOLS=200
# OPENCLAW_FEEDBACK_ROLE_CAP_EOD_SUMMARIZER=200
# OPENCLAW_FEEDBACK_ROLE_CAP_TECHNICAL_SUMMARIZER=150
# OPENCLAW_FEEDBACK_ROLE_CAP_FUNDAMENTAL_SUMMARIZER=120
# OPENCLAW_FEEDBACK_ROLE_CAP_SHORT_TERM_DECIDER=80
# OPENCLAW_FEEDBACK_ROLE_CAP_SIGNAL_DECIDER=80
# OPENCLAW_FEEDBACK_REQUESTED_SCOPE_CAP_BYPASS_MAX_SYMBOLS=50
# OPENCLAW_FEEDBACK_FORCE_INCLUDE_HOLDINGS_ENABLED=true
# OPENCLAW_FEEDBACK_FORCE_INCLUDE_ACTIVE_WATCH_ENABLED=true
# OPENCLAW_FEEDBACK_FORCE_INCLUDE_PRIOR_DECISIONS_ENABLED=true
# OPENCLAW_FEEDBACK_FORCE_INCLUDE_PRIOR_MISSED_OPPORTUNITIES_ENABLED=true
# OPENCLAW_FEEDBACK_FORCE_INCLUDE_PRIOR_MISSED_OPPORTUNITIES_BROAD_SCOPE_ENABLED=false
# OPENCLAW_FEEDBACK_FORCE_INCLUDE_EVENT_SYMBOLS_ENABLED=true
# OPENCLAW_DISPATCH_MIN_FREE_BYTES=21474836480
# OPENCLAW_SESSION_CLEANUP_ENABLED=true
# OPENCLAW_SESSION_CLEANUP_TIMEOUT_SECONDS=30
# OPENCLAW_SESSION_CLEANUP_BATCH_LIMIT=100
# OPENCLAW_SESSION_CLEANUP_RUN_BUDGET_SECONDS=40
# Legacy broad-cap env names are still accepted:
# OPENCLAW_FEEDBACK_CANDIDATE_CAP_PERCENTILE=0.10
# OPENCLAW_FEEDBACK_CANDIDATE_CAP_MIN_SYMBOLS=150
# OPENCLAW_FEEDBACK_CANDIDATE_CAP_MAX_SYMBOLS=300
# Production portfolio summary also requires KIS_APP_KEY and KIS_APP_SECRET in .env.secrets.example.
# OPENCLAW_STATE_DIR=~/.openclaw
# OPENCLAW_SIGNAL_DECIDER_EXPECTED_MODEL=openai/gpt-6.1-sol
# OPENCLAW_SHORT_TERM_DECIDER_EXPECTED_MODEL=openai/gpt-6.1-sol
# OPENCLAW_AGENT_MAX_RETRIES=0
# Optional extra start-to-start delay for synchronous /v1/responses single-flight.
# OPENCLAW_AGENT_MIN_DISPATCH_INTERVAL_SECONDS=0
# Used only when a provider 429 omits a valid Retry-After header.
# OPENCLAW_AGENT_RATE_LIMIT_FALLBACK_COOLDOWN_SECONDS=900
# OPENCLAW_AGENT_PARALLEL_SUBTASKS=1
# OPENCLAW_AGENT_SYMBOL_CHUNK_SIZE=1
# OPENCLAW_AGENT_MAX_PROMPT_CHARS=125000

# See: apps/api/app/core/settings.py
# Secret template: apps/api/.env.secrets.example
