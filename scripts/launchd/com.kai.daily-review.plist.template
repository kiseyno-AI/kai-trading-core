  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__ROOT__/scripts/run_side_agents.sh</string><string>__LABEL__</string></array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
